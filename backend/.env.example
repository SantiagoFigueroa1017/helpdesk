# Copiar este archivo como .env (en la misma carpeta backend/) y poner la contrasena real.
# .env esta en .gitignore: nunca se sube al repositorio.
# Cadena de Atlas del usuario helpdesk_app (contexto 6.7). La base se fija en application.yml.
MONGODB_URI=mongodb+srv://helpdesk_app:CAMBIAR_CONTRASENA@helpdesk.xuease5.mongodb.net/?retryWrites=true&w=majority&appName=helpdesk

# Clave para firmar los JWT (HS256): 32 bytes aleatorios en Base64 (tarea 2.4).
# Cada integrante genera la suya. En PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Si la clave cambia, los access tokens emitidos con la anterior dejan de valer.
JWT_SECRET=CAMBIAR_POR_CLAVE_BASE64

# Clave de la API de Gemini para los embeddings de la base de conocimientos (tarea 2.7).
# Se crea gratis en Google AI Studio (aistudio.google.com), sin tarjeta. Si falta, el backend arranca
# igual y la búsqueda por significado responde con la búsqueda por texto.
GEMINI_API_KEY=CAMBIAR_POR_CLAVE_GEMINI
