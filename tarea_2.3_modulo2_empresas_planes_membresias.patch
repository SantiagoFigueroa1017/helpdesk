+class PlanPersistenciaTest {
+
+    private static final Instant AHORA = Instant.parse("2026-11-02T15:30:00Z");
+
+    @Autowired
+    private PlanRepository repositorio;
+
+    @Autowired
+    private MongoTemplate template;
