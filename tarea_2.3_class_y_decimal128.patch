 /**
  * Configuracion de MongoDB.
  *
- * Spring Boot no registra un gestor de transacciones para MongoDB por su cuenta.
- * Sin este bean, @Transactional no abre ninguna transaccion y la regla de 7.5
- * (pago FALLIDO + membresia SUSPENDIDA en un solo paso) no seria atomica.
+ * <p>Transacciones (2.1): Spring Boot no registra un gestor de transacciones para MongoDB por su
+ * cuenta. Sin este bean, @Transactional no abre ninguna transaccion y la regla de 7.5 (pago
+ * FALLIDO + membresia SUSPENDIDA en un solo paso) no seria atomica.
  *
- * Pendiente para 2.3: Spring Data MongoDB 5 ya no fija por defecto como se guarda
- * BigDecimal. Hay que configurarlo como DECIMAL128 o los validadores de planes,
- * pagos y tickets (COMPRAS) rechazaran los documentos. Tambien se decide ahi _class.
+ * <p>BigDecimal (2.3): Spring Data MongoDB 5 deja por defecto la representacion UNSPECIFIED.
+ * Los validadores de planes.precio, pagos.monto y tickets.detalle.montoInvolucrado exigen
+ * Decimal128 ({@code bsonType: "decimal"}), asi que se fija DECIMAL128 aqui. Boot 4.1 tambien
+ * acepta la propiedad spring.data.mongodb.representation.big-decimal, pero no se usa: los
+ * convertidores propios (el del detalle de tickets) se registran en este mismo bean, y un bean
+ * propio de MongoCustomConversions hace que Boot ignore esa propiedad.
+ *
+ * <p>_class (2.3): no se escribe en ningun nivel. Cada coleccion corresponde a una sola clase y
+ * el unico polimorfismo (tickets.detalle) lo discrimina el campo modulo, validado por el oneOf
+ * de 6 ramas. Los validadores no admiten _class desde 2.3.
  */
 @Configuration(proxyBeanMethods = false)
 public class MongoConfig {
@@ -23,4 +39,33 @@ public class MongoConfig {
     MongoTransactionManager transactionManager(MongoDatabaseFactory databaseFactory) {
         return new MongoTransactionManager(databaseFactory);
     }
+
+    /**
+     * Conversiones propias. Reemplaza el bean de Boot (que solo aplica la propiedad de
+     * representacion de BigDecimal). En 2.3 se agrega aqui el convertidor de lectura del
+     * detalle de tickets con {@code configurer.registerConverter(...)}.
+     */
+    @Bean
+    MongoCustomConversions mongoCustomConversions() {
+        return MongoCustomConversions.create(configurer ->
+                configurer.bigDecimal(BigDecimalRepresentation.DECIMAL128));
+    }
+
+    /**
+     * Mismo convertidor que arma Boot 4.1 (DataMongoConfiguration), con un cambio: el
+     * DefaultMongoTypeMapper sin clave de tipo, para que no escriba _class.
+     */
+    @Bean
+    MappingMongoConverter mappingMongoConverter(ObjectProvider<MongoDatabaseFactory> factory,
+            MongoMappingContext context, MongoCustomConversions conversions) {
+        MongoDatabaseFactory databaseFactory = factory.getIfAvailable();
+        DbRefResolver dbRefResolver = (databaseFactory != null)
+                ? new DefaultDbRefResolver(databaseFactory)
+                : NoOpDbRefResolver.INSTANCE;
+
+        MappingMongoConverter converter = new MappingMongoConverter(dbRefResolver, context);
+        converter.setCustomConversions(conversions);
+        converter.setTypeMapper(new DefaultMongoTypeMapper(null));
+        return converter;
+    }
 }
diff --git a/backend/src/test/java/co/edu/ufpso/helpdesk/config/MongoConversionesTest.java b/backend/src/test/java/co/edu/ufpso/helpdesk/config/MongoConversionesTest.java
new file mode 100644
index 0000000..57b3394
--- /dev/null
+++ b/backend/src/test/java/co/edu/ufpso/helpdesk/config/MongoConversionesTest.java
@@ -0,0 +1,86 @@
+package co.edu.ufpso.helpdesk.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.math.BigDecimal;
+
+import org.bson.Document;
+import org.bson.types.Decimal128;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.data.mongodb.core.convert.MappingMongoConverter;
+import org.springframework.test.context.ActiveProfiles;
+
+/**
+ * Comprueba las dos decisiones de 2.3 sobre el convertidor que usa la aplicacion completa:
+ * BigDecimal se guarda como Decimal128 y _class no se escribe en ningun nivel.
+ *
+ * <p>Solo convierte en memoria, no inserta nada. Igual que {@code contextLoads}, levanta el
+ * contexto con el perfil test (conexion perezosa al rs0 local).
+ *
+ * <p>Las clases de prueba imitan los casos reales: {@code Cobro} tiene dinero como pagos.monto, y
+ * {@code detalle} esta declarado como interfaz y recibe un record concreto, igual que
+ * tickets.detalle. Con la configuracion por defecto, Spring Data escribiria _class en la raiz y
+ * dentro del detalle, y el validador lo rechazaria (500 ESQUEMA_RECHAZADO).
+ */
+@SpringBootTest
+@ActiveProfiles("test")
+class MongoConversionesTest {
+
+    @Autowired
+    private MappingMongoConverter converter;
+
+    @Test
+    void bigDecimalSeGuardaComoDecimal128() {
+        Document documento = escribir(new Cobro(new BigDecimal("1250000.50"), null));
+
+        assertThat(documento.get("monto"))
+                .isInstanceOf(Decimal128.class)
+                .isEqualTo(new Decimal128(new BigDecimal("1250000.50")));
+    }
+
+    @Test
+    void decimal128SeLeeComoBigDecimalSinPerderEscala() {
+        Document documento = new Document("monto", new Decimal128(new BigDecimal("450000.00")));
+
+        Cobro leido = converter.read(Cobro.class, documento);
+
+        assertThat(leido.monto()).isEqualTo(new BigDecimal("450000.00"));
+    }
+
+    @Test
+    void noEscribeClassEnLaRaiz() {
+        Document documento = escribir(new Cobro(new BigDecimal("1"), null));
+
+        assertThat(documento).doesNotContainKey("_class");
+        assertThat(converter.getTypeMapper().isTypeKey("_class")).isFalse();
+    }
+
+    @Test
+    void noEscribeClassEnUnEmbebidoPolimorfico() {
+        Document documento = escribir(new Cobro(new BigDecimal("1"),
+                new DetalleCompra("900123456-1", new BigDecimal("98000.25"))));
+
+        Document detalle = documento.get("detalle", Document.class);
+        assertThat(detalle).doesNotContainKey("_class");
+        assertThat(detalle.keySet()).containsExactlyInAnyOrder("nitProveedor", "montoInvolucrado");
+        assertThat(detalle.get("montoInvolucrado")).isInstanceOf(Decimal128.class);
+    }
+
+    private Document escribir(Object entidad) {
+        Document documento = new Document();
+        converter.write(entidad, documento);
+        return documento;
+    }
+
+    /** Declarado como interfaz, igual que DetalleTicket en tickets. */
+    interface Detalle {
+    }
+
+    record DetalleCompra(String nitProveedor, BigDecimal montoInvolucrado) implements Detalle {
+    }
+
+    record Cobro(BigDecimal monto, Detalle detalle) {
+    }
+}
